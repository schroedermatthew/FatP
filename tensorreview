## 2️⃣  `Status` – full RAII class with safer `set`, `operator!`, and proper destructor  

```cpp
// tf_status.hpp  (add to the same header that already contains the snippets)

#pragma once
#include <tensorflow/c/c_api.h>
#include <string_view>
#include <stdexcept>
#include <format>
#include <source_location>

namespace tf {

class Status {
public:
    // ----- construction / destruction ---------------------------------------
    Status() noexcept
        : st_{TF_NewStatus()}
    {}

    explicit Status(TF_Status* raw) noexcept
        : st_{raw}
    {}

    // non‑copyable (TF_Status is not copy‑able)
    Status(const Status&) = delete;
    Status& operator=(const Status&) = delete;

    // movable – transfers ownership of the raw pointer
    Status(Status&& other) noexcept
        : st_{other.st_}
    {
        other.st_ = nullptr;
    }

    Status& operator=(Status&& other) noexcept {
        if (this != &other) {
            destroy();
            st_ = other.st_;
            other.st_ = nullptr;
        }
        return *this;
    }

    ~Status() noexcept { destroy(); }

    // ----- basic queries ----------------------------------------------------
    [[nodiscard]] bool ok() const noexcept { return code() == TF_OK; }

    // explicit bool conversion (already present)
    [[nodiscard]] explicit operator bool() const noexcept { return ok(); }

    // complementary operator! for `if (!status) …`
    [[nodiscard]] bool operator!() const noexcept { return !ok(); }

    // ----- mutation ---------------------------------------------------------
    void reset() noexcept {
        TF_SetStatus(st_, TF_OK, "");
    }

    // now takes a std::string_view – no dangling‑pointer risk
    void set(TF_Code code, std::string_view msg) noexcept {
        TF_SetStatus(st_, code, msg.empty() ? "" : msg.data());
    }

    // ----- accessors ---------------------------------------------------------
    [[nodiscard]] TF_Code code() const noexcept { return TF_GetCode(st_); }

    [[nodiscard]] const char* message() const noexcept {
        return TF_Message(st_);
    }

    // ----- pretty printing ---------------------------------------------------
    [[nodiscard]] const char* code_name() const noexcept {
        return code_to_string(code()).data();   // uses the helper above
    }

    // ----- error handling ----------------------------------------------------
    void throw_if_error(
        std::string_view context = "",
        std::source_location loc = std::source_location::current()) const
    {
        if (ok()) return;

        std::string msg;
        if (context.empty()) {
            msg = std::format("[TF_{}] at {}:{} in {}: {}",
                code_name(),
                loc.file_name(),
                loc.line(),
                loc.function_name(),
                message());
        } else {
            msg = std::format("[TF_{}] {} at {}:{}: {}",
                code_name(),
                context,
                loc.file_name(),
                loc.line(),
                message());
        }
        throw std::runtime_error(std::move(msg));
    }

private:
    TF_Status* st_{nullptr};

    void destroy() noexcept {
        if (st_) {
            TF_DeleteStatus(st_);
            st_ = nullptr;
        }
    }
};

// ---------------------------------------------------------------------------
// Free‑function helpers (unchanged except they now work with the new Status)

inline void throw_if_error(
    const Status& st,
    std::string_view context = "",
    std::source_location loc = std::source_location::current())
{
    st.throw_if_error(context, loc);
}
```

*Key improvements*  

* RAII destructor (`destroy`) guarantees **no memory leak**.  
* `set` now uses `std::string_view`, eliminating unsafe raw‑pointer parameters.  
* Added `operator!` for idiomatic `if (!status) …`.  
* Move semantics let you return a `Status` from factory functions without copying.

