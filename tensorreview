## 4️⃣  `OperationBuilder` – add a move overload for fluent chaining  

```cpp
// tf_operation_builder.hpp (excerpt – add the overloads)

#pragma once
#include <tensorflow/c/c_api.h>
#include <span>
#include <stdexcept>
#include <format>
#include "tf_status.hpp"

namespace tf {

class OperationBuilder {
public:
    // Existing constructor that receives a TF_OperationDescription*
    explicit OperationBuilder(TF_OperationDescription* desc) noexcept
        : desc_{desc}
    {}

    // -----------------------------------------------------------------------
    // Existing lvalue setters (unchanged)
    OperationBuilder& SetAttrTensor(const char* name, const Tensor<policy::NoLock>& t) & {
        Status st;
        TF_SetAttrTensor(desc_, name, t.get(), &st);
        st.throw_if_error(name);
        return *this;
    }

    // -----------------------------------------------------------------------
    // NEW: rvalue overloads – enable `auto builder = graph.AddOperation(...).Set…();`
    OperationBuilder&& SetAttrTensor(const char* name,
                                     const Tensor<policy::NoLock>& t) && {
        // Forward to the lvalue implementation, then return std::move(*this)
        SetAttrTensor(name, t);
        return std::move(*this);
    }

    // Repeat for a few other common setters (you can add more as needed)

    OperationBuilder& SetAttrType(const char* name, TF_DataType dtype) & {
        TF_SetAttrType(desc_, name, dtype);
        return *this;
    }

    OperationBuilder&& SetAttrType(const char* name, TF_DataType dtype) && {
        SetAttrType(name, dtype);
        return std::move(*this);
    }

    OperationBuilder& AddInput(TF_Operation* op, int index = 0) & {
        TF_AddInput(desc_, TF_Output{op, index});
        return *this;
    }

    OperationBuilder&& AddInput(TF_Operation* op, int index = 0) && {
        AddInput(op, index);
        return std::move(*this);
    }

    // -----------------------------------------------------------------------
    // Finish building and obtain the TF_Operation*
    TF_Operation* Finish(std::string_view name = {}) {
        if (!name.empty()) {
            TF_SetAttrString(desc_, "name", name.data(), static_cast<int>(name.size()));
        }
        return TF_FinishOperation(desc_, nullptr);
    }

private:
    TF_OperationDescription* desc_;   // non‑owning; Graph owns the underlying object
};
} // namespace tf
```

*Result* – The builder now works equally well when kept as an lvalue **or** when you chain calls that move the temporary builder forward, e.g.:

```cpp
auto* op = graph.AddOperation("MyOp")
                 .SetAttrType("T", TF_FLOAT)
                 .SetAttrTensor("value", myTensor)
                 .AddInput(prev_op)
                 .Finish();
```

