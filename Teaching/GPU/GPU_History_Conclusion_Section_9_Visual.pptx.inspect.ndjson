{"kind":"textbox","id":"sh/xwbadcry","slide":3,"text":"Custom kernels still matter for the glue between operations.","textPreview":"Custom kernels still matter for the glue between operations.","textChars":60,"textLines":1,"bbox":[110,602,990,24]}
